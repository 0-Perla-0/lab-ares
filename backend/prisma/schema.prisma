generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum RolUsuario {
  PRESTADOR
  COORDINADOR
  JEFE_COORDINADORES
  JEFE_AREA
  JEFE_SEDE
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  PENDIENTE
  INACTIVO
  LIBERADO
  BAJA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model Sede {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique @db.VarChar(150)
  direccion String? @db.VarChar(255)

  activa Boolean @default(true)

  areas    Area[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(150)

  activa Boolean @default(true)

  sedeId Int
  sede   Sede @relation(fields: [sedeId], references: [id], onDelete: Restrict)

  turnos   Turno[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, nombre])
  @@index([sedeId])
}

model Turno {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(100)

  horaInicio DateTime @db.Time(0)
  horaFin    DateTime @db.Time(0)

  activo Boolean @default(true)

  areaId Int
  area   Area @relation(fields: [areaId], references: [id], onDelete: Restrict)

  dias     TurnoDia[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaId, nombre])
  @@index([areaId])
}

model TurnoDia {
  turnoId Int
  dia     DiaSemana

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@id([turnoId, dia])
}

model Usuario {
  id Int @id @default(autoincrement())

  codigo String @unique @db.VarChar(50)
  email  String @unique @db.VarChar(191)

  passwordHash String @db.VarChar(255)

  rol    RolUsuario    @default(PRESTADOR)
  estado EstadoUsuario @default(PENDIENTE)

  sedeId  Int?
  areaId  Int?
  turnoId Int?

  sede  Sede?  @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  area  Area?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  turno Turno? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  asistencias Asistencia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rol])
  @@index([estado])
  @@index([sedeId])
  @@index([areaId])
  @@index([turnoId])
}

model Session {
  id        String   @id @db.VarChar(191)
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

enum EstadoAsistencia {
  ABIERTA
  PENDIENTE
  AUTORIZADA
  RECHAZADA
}

model Asistencia {
  id Int @id @default(autoincrement())
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // NULL after closing. A unique nullable key enforces one open interval per user.
  openUserId Int? @unique
  // Organizational assignment at check-in, retained even after a transfer.
  sedeId Int
  areaId Int
  turnoId Int
  checkInAt DateTime @db.DateTime(3)
  checkOutAt DateTime? @db.DateTime(3)
  durationSeconds Int?
  status EstadoAsistencia @default(ABIERTA)
  closeReason String? @db.VarChar(500)
  closedById Int?
  events AsistenciaEvento[]

  @@index([userId, id])
  @@index([status, areaId, id])
  @@index([status, sedeId, id])
}

model AsistenciaEvento {
  id Int @id @default(autoincrement())
  attendanceId Int
  attendance Asistencia @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  actorId Int
  action String @db.VarChar(30)
  occurredAt DateTime @db.DateTime(3)
  reason String? @db.VarChar(500)

  @@index([attendanceId, id])
}

model AsistenciaSolicitud {
  actorId Int
  key String @db.VarChar(100)
  fingerprint String @db.Char(64)
  response Json
  createdAt DateTime @default(now())

  @@id([actorId, key])
}
