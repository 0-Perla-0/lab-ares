enum TipoArticuloInventario {
  CONSUMIBLE
  ACTIVO
}
enum EstadoActivoInventario {
  DISPONIBLE
  EN_PRESTAMO
  EN_MANTENIMIENTO
  DANIADO
  BAJA
}
enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
  PRESTAMO
  DEVOLUCION
}
model UbicacionInventario {
  id Int @id @default(autoincrement())
  sedeId Int
  sede Sede @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  areaId Int?
  area Area? @relation(fields: [areaId], references: [id], onDelete: Restrict)
  nombre String @db.VarChar(100)
  codigo String @db.VarChar(50)
  activa Boolean @default(true)
  articulos ArticuloInventario[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@unique([sedeId, codigo])
}
model ArticuloInventario {
  id String @id @default(cuid()) @db.VarChar(30)
  codigo String @unique @db.VarChar(60)
  nombre String @db.VarChar(150)
  descripcion String? @db.VarChar(1000)
  tipo TipoArticuloInventario
  unidadMedida String? @db.VarChar(30)
  // Materialized ledger balance, only changed in the same transaction as a movement.
  cantidadStock Decimal @default(0) @db.Decimal(10, 2)
  umbralMinimo Decimal? @db.Decimal(10, 2)
  estadoActivo EstadoActivoInventario?
  version Int @default(1)
  ubicacionId Int
  ubicacion UbicacionInventario @relation(fields: [ubicacionId], references: [id], onDelete: Restrict)
  movimientos MovimientoInventario[]
  prestamos PrestamoInventario[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@index([tipo, estadoActivo])
  @@index([ubicacionId])
}
model MovimientoInventario {
  id String @id @default(cuid()) @db.VarChar(30)
  articuloId String @db.VarChar(30)
  articulo ArticuloInventario @relation(fields: [articuloId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "MovimientoInventario_articuloId_immutable_fkey")
  tipo TipoMovimientoInventario
  // Signed delta; append-only application API.
  cantidad Decimal @db.Decimal(10, 2)
  motivo String @db.VarChar(500)
  actorId Int
  actor Usuario @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "MovimientoInventario_actorId_immutable_fkey")
  prestamoId String? @db.VarChar(30)
  prestamo PrestamoInventario? @relation(fields: [prestamoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "MovimientoInventario_prestamoId_immutable_fkey")
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([articuloId, createdAt])
}
model PrestamoInventario {
  id String @id @default(cuid()) @db.VarChar(30)
  articuloId String @db.VarChar(30)
  articulo ArticuloInventario @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  solicitanteId Int
  solicitante Usuario @relation("LoanBorrower", fields: [solicitanteId], references: [id], onDelete: Restrict)
  responsableId Int
  responsable Usuario @relation("LoanResponsible", fields: [responsableId], references: [id], onDelete: Restrict)
  devueltoAId Int?
  devueltoA Usuario? @relation("LoanReturn", fields: [devueltoAId], references: [id], onDelete: Restrict)
  fechaEntrega DateTime @default(now()) @db.DateTime(3)
  fechaLimite DateTime @db.DateTime(3)
  fechaDevolucion DateTime? @db.DateTime(3)
  estado String @default("ACTIVO") @db.VarChar(20)
  observaciones String? @db.VarChar(1000)
  movimientos MovimientoInventario[]
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([estado, fechaLimite])
}

