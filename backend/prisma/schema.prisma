generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum RolUsuario {
  PRESTADOR
  COORDINADOR
  JEFE_COORDINADORES
  JEFE_AREA
  JEFE_SEDE
  ADMIN
}

enum EstadoUsuario {
  INVITADA
  ACTIVA
  SUSPENDIDA
  DESACTIVADA
  BLOQUEADA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum EstadoAdscripcionAcademica {
  PENDIENTE_CONFIRMACION
  CONFIRMADA
  RECHAZADA
}

model Sede {
  politicasAsistencia PoliticaAsistencia[]
  id        Int     @id @default(autoincrement())
  nombre    String  @unique @db.VarChar(150)
  direccion String? @db.VarChar(255)

  activa Boolean @default(true)

  areas    Area[]
  usuarios Usuario[]
  bibliotecaDocumentos DocumentoBiblioteca[]
  excepcionesCalendario ExcepcionCalendario[]
  visitas InvitacionVisita[]
  ubicacionesInventario UbicacionInventario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(150)

  activa Boolean @default(true)

  sedeId Int
  sede   Sede @relation(fields: [sedeId], references: [id], onDelete: Restrict)

  turnos   Turno[]
  usuarios Usuario[]
  bibliotecaDocumentos DocumentoBiblioteca[]
  excepcionesCalendario ExcepcionCalendario[]
  visitas InvitacionVisita[]
  ubicacionesInventario UbicacionInventario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, nombre])
  @@index([sedeId])
}

model Turno {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(100)

  horaInicio DateTime @db.Time(0)
  horaFin    DateTime @db.Time(0)

  activo Boolean @default(true)

  areaId Int
  area   Area @relation(fields: [areaId], references: [id], onDelete: Restrict)

  dias     TurnoDia[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaId, nombre])
  @@index([areaId])
}

model TurnoDia {
  turnoId Int
  dia     DiaSemana

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@id([turnoId, dia])
}

model Usuario {
  validacionesAsistencia AsistenciaValidacion[]
  politicasAsistencia PoliticaAsistencia[]
  id Int @id @default(autoincrement())

  codigo String @unique @db.VarChar(50)
  email  String @unique @db.VarChar(191)

  passwordHash String @db.VarChar(255)

  rol    RolUsuario    @default(PRESTADOR)
  estado EstadoUsuario @default(INVITADA)

  sedeId  Int?
  areaId  Int?
  turnoId Int?

  sede  Sede?  @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  area  Area?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  turno Turno? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  asistencias Asistencia[]
  visitas InvitacionVisita[] @relation("VisitHost")
  entradasVisita InvitacionVisita[] @relation("VisitEntry")
  salidasVisita InvitacionVisita[] @relation("VisitExit")
  movimientosInventario MovimientoInventario[]
  prestamosSolicitados PrestamoInventario[] @relation("LoanBorrower")
  prestamosEntregados PrestamoInventario[] @relation("LoanResponsible")
  devolucionesRecibidas PrestamoInventario[] @relation("LoanReturn")
  sessions Session[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  invitationsTarget Invitation[] @relation("InvitationTarget")
  recoveryTokens RecoveryToken[]
  mfa UserMfa?
  mfaChallenges MfaChallenge[]
  recoveryCodes MfaRecoveryCode[]
  notifications Notification[]
  adscripcionesAcademicas AdscripcionAcademica[]
  solicitudesAcademicas AdscripcionAcademica[] @relation("AcademicRequester")
  confirmacionesAcademicas AdscripcionAcademica[] @relation("AcademicConfirmer")
  requisitosDocumentales RequisitoDocumento[]
  formalizacionesExpediente FormalizacionExpediente[] @relation("ExpedientSubject")
  periodosServicio PeriodoServicio[] @relation("ServicePeriodSubject")
  eventosPeriodoServicio EventoPeriodoServicio[] @relation("ServicePeriodActor")
  expedientesFormalizados FormalizacionExpediente[] @relation("ExpedientAuthority")
  documentosCargados DocumentoVersion[] @relation("DocumentoUploader")
  documentosRevisados DocumentoVersion[] @relation("DocumentoReviewer")
  kairosProjectsCreated ProyectoKairos[] @relation("KairosProjectCreator")
  kairosMemberships MiembroProyectoKairos[]
  kairosFavorites FavoritoProyectoKairos[]
  kairosActivitiesResponsible ActividadKairos[] @relation("KairosActivityResponsible")
  kairosActivityParticipants ParticipanteActividadKairos[]
  kairosEvidenceAuthors EntregaEvidenciaKairos[]
  kairosActivityComments ComentarioActividadKairos[]
  kairosActivityReviews HistorialActividadKairos[] @relation("KairosActivityReviewer")
  kairosActivityHistory HistorialActividadKairos[] @relation("KairosActivityActor")
  archivosPropiedad Archivo[] @relation("ArchivoOwner")
  directorioPreferencia DirectorioPreferencia?
  reportExportsRequested ReporteExportacion[]
  bibliotecaDocumentosCreados DocumentoBiblioteca[] @relation("LibraryDocumentCreator")
  bibliotecaDocumentosArchivados DocumentoBiblioteca[] @relation("LibraryDocumentArchiver")
  bibliotecaVersionesCreadas VersionBiblioteca[] @relation("LibraryVersionAuthor")
  bibliotecaVersionesRevisadas VersionBiblioteca[] @relation("LibraryVersionReviewer")
  bibliotecaVersionesPublicadas VersionBiblioteca[] @relation("LibraryVersionPublisher")
  bibliotecaAcuses AcuseBiblioteca[]
  paginasPublicasCreadas PaginaPublica[] @relation("PublicPageCreator")
  paginasPublicasArchivadas PaginaPublica[] @relation("PublicPageArchiver")
  contenidoPublicoCreado VersionContenidoPublico[] @relation("PublicContentAuthor")
  contenidoPublicoPublicado VersionContenidoPublico[] @relation("PublicContentPublisher")
  activosPublicosPublicados ActivoPublico[] @relation("PublicAssetPublisher")
  reglasGamificacionCreadas ReglaGamificacion[] @relation("GamificationRuleCreator")
  insigniasGamificacionCreadas InsigniaGamificacion[] @relation("GamificationBadgeCreator")
  eventosGamificacion EventoGamificacion[] @relation("GamificationSubject")
  eventosGamificacionActuados EventoGamificacion[] @relation("GamificationActor")
  trabajosImpresion3DSolicitados TrabajoImpresion3D[] @relation("Printing3DRequester")
  trabajosImpresion3DAsignados TrabajoImpresion3D[] @relation("Printing3DOperator")
  trabajosImpresion3DRevisados TrabajoImpresion3D[] @relation("Printing3DReviewer")
  trabajosImpresion3DCancelados TrabajoImpresion3D[] @relation("Printing3DCanceller")
  ejecucionesImpresion3D EjecucionImpresion3D[] @relation("Printing3DExecutionOperator")
  operacionesImpresion3D OperacionImpresion3D[] @relation("Printing3DOperationActor")
  reglasRetencionCreadas ReglaRetencion[] @relation("RetentionRuleCreator")
  reglasRetencionAprobadas ReglaRetencion[] @relation("RetentionRuleApprover")
  registrosRetencion RegistroRetencion[] @relation("RetentionSubject")
  retencionesLegalesCreadas RetencionLegal[] @relation("LegalHoldCreator")
  retencionesLegalesLiberadas RetencionLegal[] @relation("LegalHoldReleaser")
  solicitudesSupresion SolicitudSupresion[] @relation("SuppressionRequester")
  solicitudesSupresionResueltas SolicitudSupresion[] @relation("SuppressionResolver")
  lotesSupresionCreados LoteSupresion[] @relation("SuppressionBatchCreator")
  lotesSupresionAutorizados LoteSupresion[] @relation("SuppressionBatchAuthorizer")
  registrosSupresionEjecutados RegistroSupresion[] @relation("SuppressionExecutor")
  operacionesRetencion OperacionRetencion[] @relation("RetentionOperationActor")
  ausencias Ausencia[] @relation("AbsenceSubject")
  ausenciasResueltas Ausencia[] @relation("AbsenceResolver")
  apelacionesResueltas ApelacionAusencia[] @relation("AppealResolver")
  justificacionesAusencia JustificacionAusencia[]
  excepcionesCalendario ExcepcionCalendario[] @relation("CalendarSubject")
  excepcionesCreadas ExcepcionCalendario[] @relation("CalendarCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rol])
  @@index([estado])
  @@index([sedeId])
  @@index([areaId])
  @@index([turnoId])
}

model DirectorioPreferencia {
  usuarioId Int @id
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  visibleEnArea Boolean @default(true)
  visibleEnProyectos Boolean @default(true)
  mostrarEmail Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model InstitucionAcademica {
  id Int @id @default(autoincrement())
  nombre String @unique @db.VarChar(191)
  activa Boolean @default(true)
  unidades UnidadAcademica[]
  adscripciones AdscripcionAcademica[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([activa])
}

model UnidadAcademica {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(191)
  activa Boolean @default(true)
  institucionId Int
  institucion InstitucionAcademica @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  programas ProgramaAcademico[]
  adscripciones AdscripcionAcademica[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([institucionId, nombre])
  @@index([institucionId, activa])
}

model ProgramaAcademico {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(191)
  activa Boolean @default(true)
  unidadAcademicaId Int
  unidadAcademica UnidadAcademica @relation(fields: [unidadAcademicaId], references: [id], onDelete: Restrict)
  adscripciones AdscripcionAcademica[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([unidadAcademicaId, nombre])
  @@index([unidadAcademicaId, activa])
}

model CohorteAcademica {
  id Int @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)
  activa Boolean @default(true)
  adscripciones AdscripcionAcademica[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([activa])
}

model AdscripcionAcademica {
  formalizacionesExpediente FormalizacionExpediente[]
  id Int @id @default(autoincrement())
  usuarioId Int
  institucionId Int
  unidadAcademicaId Int?
  programaAcademicoId Int
  cohorteId Int?
  inicio DateTime @db.Date
  fin DateTime? @db.Date
  vigente Boolean @default(true)
  estado EstadoAdscripcionAcademica @default(PENDIENTE_CONFIRMACION)
  motivoRechazo String? @db.VarChar(500)
  solicitadoPorId Int?
  confirmadoPorId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  institucion InstitucionAcademica @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  unidadAcademica UnidadAcademica? @relation(fields: [unidadAcademicaId], references: [id], onDelete: Restrict)
  programaAcademico ProgramaAcademico @relation(fields: [programaAcademicoId], references: [id], onDelete: Restrict)
  cohorte CohorteAcademica? @relation(fields: [cohorteId], references: [id], onDelete: Restrict)
  solicitadoPor Usuario? @relation("AcademicRequester", fields: [solicitadoPorId], references: [id], onDelete: SetNull)
  confirmadoPor Usuario? @relation("AcademicConfirmer", fields: [confirmadoPorId], references: [id], onDelete: SetNull)
  @@index([usuarioId, vigente, inicio])
  @@index([institucionId, programaAcademicoId])
}

model Session {
  id        String   @id @db.VarChar(191)
  data      Json
  expiresAt DateTime
  userId Int?
  user Usuario? @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastActivityAt DateTime @default(now())
  absoluteExpiresAt DateTime @default(now())
  revokedAt DateTime?
  ipHash String? @db.Char(64)
  userAgentSummary String? @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model Invitation {
  id String @id @default(cuid()) @db.VarChar(30)
  tokenHash String @unique @db.Char(64)
  targetEmail String @db.VarChar(191)
  targetUserId Int?
  targetUser Usuario? @relation("InvitationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  role RolUsuario
  sedeId Int?
  areaId Int?
  turnoId Int?
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdById Int
  createdBy Usuario @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedById Int?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([targetEmail, expiresAt])
  @@index([createdById])
  @@index([archivedAt])
}

model RecoveryToken {
  id String @id @default(cuid()) @db.VarChar(30)
  tokenHash String @unique @db.Char(64)
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model UserMfa {
  userId Int @id
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretCiphertext String @db.Text
  enabledAt DateTime?
  lastAcceptedStep BigInt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MfaChallenge {
  id String @id @default(cuid()) @db.VarChar(30)
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime
  attempts Int @default(0)
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model MfaRecoveryCode {
  id String @id @default(cuid()) @db.VarChar(30)
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @unique @db.Char(64)
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, usedAt])
}

model Notification {
  id String @id @default(cuid()) @db.VarChar(30)
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String @db.VarChar(100)
  payload Json
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
}

model OutboxEvent {
  id String @id @default(cuid()) @db.VarChar(30)
  type String @db.VarChar(100)
  aggregateId String @db.VarChar(100)
  payload Json
  occurredAt DateTime @default(now())
  processedAt DateTime?
  attempts Int @default(0)
  state String @default("PENDING") @db.VarChar(20)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseOwner String? @db.VarChar(80)
  lastError String? @db.VarChar(500)
  failedAt DateTime?
  emailDeliveries EmailDelivery[]
  @@index([processedAt, occurredAt])
  @@index([state, nextAttemptAt])
}

model EmailDelivery {
  id String @id @default(cuid()) @db.VarChar(30)
  outboxEventId String @unique @db.VarChar(30)
  event OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  status String @db.VarChar(20)
  attempts Int @default(0)
  errorRedacted String? @db.VarChar(500)
  sentAt DateTime?
  messageId String @unique @db.VarChar(180)
  leaseUntil DateTime?
  leaseOwner String? @db.VarChar(80)
  createdAt DateTime @default(now())
  @@index([status, leaseUntil])
  @@index([outboxEventId, createdAt])
}

model AuditEvent {
  id String @id @default(cuid()) @db.VarChar(30)
  actorId Int?
  subjectId Int?
  action String @db.VarChar(100)
  resource String @db.VarChar(100)
  correlationId String? @db.VarChar(100)
  metadata Json?
  actorType String @default("HUMAN") @db.VarChar(20)
  actorRole String? @db.VarChar(40)
  accessScope String? @db.VarChar(20)
  module String @default("LEGACY") @db.VarChar(60)
  objectType String? @db.VarChar(100)
  objectId String? @db.VarChar(100)
  result String @default("SUCCESS") @db.VarChar(30)
  reason String? @db.VarChar(500)
  diff Json?
  policyVersion String? @db.VarChar(50)
  batchId String? @db.VarChar(100)
  jobId String? @db.VarChar(100)
  sedeId Int?
  areaId Int?
  periodKey String? @db.Char(10)
  chainIndex Int?
  previousHash String? @db.Char(64)
  eventHash String? @db.Char(64)
  occurredAt DateTime @default(now()) @db.DateTime(3)
  @@index([resource, subjectId, occurredAt])
  @@index([actorId, occurredAt])
  @@unique([periodKey, chainIndex])
  @@index([module, action, occurredAt])
  @@index([correlationId])
  @@index([sedeId, areaId, occurredAt])
}

model AuditManifest {
  id String @id @default(cuid()) @db.VarChar(30)
  periodKey String @unique @db.Char(10)
  eventCount Int
  firstHash String? @db.Char(64)
  lastHash String? @db.Char(64)
  manifestHash String @db.Char(64)
  storageRef String? @db.VarChar(255)
  verifiedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
}

model AuditChainHead {
  periodKey String @id @db.Char(10)
  lastIndex Int @default(0)
  lastHash String? @db.Char(64)
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

enum OperationalJobState {
  PENDING
  RUNNING
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum OperationalAttemptResult {
  RUNNING
  SUCCEEDED
  FAILED
  LEASE_LOST
}

enum OperationalAlertState {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum OperationalSeverity {
  S1
  S2
  S3
  S4
}

enum OperationalIncidentState {
  ABIERTO
  RECONOCIDO
  INVESTIGANDO
  MITIGANDO
  MONITOREANDO
  RESUELTO
  CERRADO
}

model OperationalJobExecution {
  id String @id @default(cuid()) @db.VarChar(30)
  name String @db.VarChar(100)
  idempotencyKey String @unique @db.VarChar(191)
  state OperationalJobState @default(PENDING)
  actorType String @default("SYSTEM") @db.VarChar(20)
  correlationId String? @db.VarChar(100)
  payload Json?
  result Json?
  errorCode String? @db.VarChar(100)
  attempts Int @default(0)
  maxAttempts Int @default(3)
  nextAttemptAt DateTime @default(now()) @db.DateTime(3)
  leaseOwner String? @db.VarChar(100)
  leaseUntil DateTime? @db.DateTime(3)
  startedAt DateTime? @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  attemptHistory OperationalJobAttempt[]
  alerts OperationalAlert[]
  @@index([state,nextAttemptAt])
  @@index([name,createdAt])
  @@index([leaseUntil])
}

model OperationalJobAttempt {
  id String @id @default(cuid()) @db.VarChar(30)
  executionId String @db.VarChar(30)
  execution OperationalJobExecution @relation(fields:[executionId], references:[id], onDelete:Restrict)
  number Int
  owner String @db.VarChar(100)
  result OperationalAttemptResult @default(RUNNING)
  errorCode String? @db.VarChar(100)
  startedAt DateTime @default(now()) @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  @@unique([executionId,number])
  @@index([result,startedAt])
}

model OperationalAlert {
  id String @id @default(cuid()) @db.VarChar(30)
  severity OperationalSeverity
  state OperationalAlertState @default(OPEN)
  source String @db.VarChar(100)
  code String @db.VarChar(100)
  message String @db.VarChar(500)
  jobExecutionId String? @db.VarChar(30)
  jobExecution OperationalJobExecution? @relation(fields:[jobExecutionId], references:[id], onDelete:Restrict)
  acknowledgedById Int?
  acknowledgedAt DateTime? @db.DateTime(3)
  resolvedById Int?
  resolvedAt DateTime? @db.DateTime(3)
  resolution String? @db.VarChar(500)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  @@index([state,severity,createdAt])
  @@index([jobExecutionId])
}

model OperationalIncident {
  id String @id @default(cuid()) @db.VarChar(30)
  externalTicketRef String @unique @db.VarChar(191)
  severity OperationalSeverity
  state OperationalIncidentState @default(ABIERTO)
  ownerId Int?
  reason String @db.VarChar(1000)
  communications Json?
  repeatedS2 Boolean @default(false)
  postmortemDueAt DateTime? @db.DateTime(3)
  resolvedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  history OperationalIncidentEvent[]
  @@index([state,severity,createdAt])
  @@index([ownerId,state])
}

model OperationalIncidentEvent {
  id String @id @default(cuid()) @db.VarChar(30)
  incidentId String @db.VarChar(30)
  incident OperationalIncident @relation(fields:[incidentId], references:[id], onDelete:Restrict)
  actorId Int
  previousState OperationalIncidentState?
  nextState OperationalIncidentState?
  previousSeverity OperationalSeverity?
  nextSeverity OperationalSeverity?
  ownerId Int?
  reason String @db.VarChar(1000)
  occurredAt DateTime @default(now()) @db.DateTime(3)
  @@index([incidentId,occurredAt])
}

enum RecoveryScope {
  CRITICO
  IMPORTANTE
  SECUNDARIO
}

enum RecoveryRunState {
  PLANNED
  FROZEN
  RESTORE_RECORDED
  RECONCILIATION_PREVIEWED
  RECONCILED
  AUDIT_VERIFIED
  JOURNAL_IMPORTED
  SUPPRESSIONS_REAPPLIED
  READY_APPROVED
  COMPLETED
  FAILED
  CANCELLED
}

enum RecoveryStepType {
  PLAN
  FREEZE
  RESTORE_RECORD
  RECONCILIATION_PREVIEW
  RECONCILIATION_EXECUTE
  AUDIT_VERIFY
  JOURNAL_IMPORT
  SUPPRESSION_REAPPLY
  READY_APPROVAL
  UNFREEZE
  COMPLETE
  FAIL
  CANCEL
}

enum RecoveryStepState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum RecoveryCheckType {
  DATABASE
  STORAGE
  SCANNER
  OUTBOX
  SECONDARY_MODULES
  AUDIT_INTEGRITY
  JOURNAL_INTEGRITY
  READINESS
}

enum RecoveryReconciliationMode {
  PREVIEW
  EXECUTE
}

enum RecoveryReconciliationState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum RecoveryDrillResult {
  PENDING
  PASSED
  PARTIAL
  FAILED
}

enum SuppressionJournalState {
  PENDING
  PROCESSING
  EXPORTED
  FAILED
}

model RecoveryRun {
  id String @id @default(cuid()) @db.VarChar(30)
  name String @db.VarChar(191)
  scope RecoveryScope
  state RecoveryRunState @default(PLANNED)
  isDrill Boolean @default(false)
  restorePoint DateTime? @db.DateTime(3)
  imageVersion String? @db.VarChar(191)
  externalProviderRef String? @db.VarChar(191)
  createdById Int
  responsibleId Int
  frozenById Int?
  readyApprovedById Int?
  completedById Int?
  failedById Int?
  cancelledById Int?
  rpoTargetMinutes Int
  rtoTargetMinutes Int
  actualRpoMinutes Int?
  actualRtoMinutes Int?
  drillResult RecoveryDrillResult @default(PENDING)
  drillNotes String? @db.VarChar(1000)
  startedAt DateTime @default(now()) @db.DateTime(3)
  frozenAt DateTime? @db.DateTime(3)
