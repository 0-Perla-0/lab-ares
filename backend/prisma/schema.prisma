generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum RolUsuario {
  PRESTADOR
  COORDINADOR
  JEFE_COORDINADORES
  JEFE_AREA
  JEFE_SEDE
  ADMIN
}

enum EstadoUsuario {
  ACTIVO
  PENDIENTE
  INACTIVO
  LIBERADO
  BAJA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum EstadoAsistencia {
  ABIERTA
  CERRADA
  CHECKOUT_OMITIDO
}

enum NivelRiesgoAsistencia {
  NO_EVALUADO
  VERDE
  AMARILLO
  ROJO
}

enum EstadoValidacionAsistencia {
  PENDIENTE
  REQUIERE_REVISION
  AUTORIZADA
  RECHAZADA
}

enum TipoOperacionAsistencia {
  CHECK_IN
  CHECK_OUT
}

model Sede {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique @db.VarChar(150)
  direccion String? @db.VarChar(255)

  activa Boolean @default(true)

  areas    Area[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(150)

  activa Boolean @default(true)

  sedeId Int
  sede   Sede @relation(fields: [sedeId], references: [id], onDelete: Restrict)

  turnos   Turno[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, nombre])
  @@index([sedeId])
}

model Turno {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(100)

  horaInicio DateTime @db.Time(0)
  horaFin    DateTime @db.Time(0)

  activo Boolean @default(true)

  areaId Int
  area   Area @relation(fields: [areaId], references: [id], onDelete: Restrict)

  dias     TurnoDia[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaId, nombre])
  @@index([areaId])
}

model TurnoDia {
  turnoId Int
  dia     DiaSemana

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@id([turnoId, dia])
}

model Usuario {
  id Int @id @default(autoincrement())

  codigo String @unique @db.VarChar(50)
  email  String @unique @db.VarChar(191)

  passwordHash String @db.VarChar(255)

  rol    RolUsuario    @default(PRESTADOR)
  estado EstadoUsuario @default(PENDIENTE)

  sedeId  Int?
  areaId  Int?
  turnoId Int?

  sede  Sede?  @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  area  Area?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  turno Turno? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  asistencias           Asistencia[]
  operacionesAsistencia OperacionIdempotenteAsistencia[]
  eventosAuditoria      EventoAuditoria[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rol])
  @@index([estado])
  @@index([sedeId])
  @@index([areaId])
  @@index([turnoId])
}

model Session {
  id        String   @id @db.VarChar(191)
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Asistencia {
  id String @id @default(uuid()) @db.Char(36)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  /// Copias históricas del alcance al momento del check-in. No conceden permisos.
  sedeId  Int?
  areaId  Int?
  turnoId Int?

  estado EstadoAsistencia @default(ABIERTA)

  entradaAt DateTime
  salidaAt  DateTime?

  /// `true` únicamente mientras la sesión está abierta. MySQL permite varios
  /// `NULL`, por lo que el índice compuesto garantiza una sola abierta por usuario.
  openSlot Boolean? @default(true)

  duracionMinutos Int?

  nivelRiesgo        NivelRiesgoAsistencia      @default(NO_EVALUADO)
  motivosRiesgo      Json
  versionReglaRiesgo String                     @db.VarChar(80)
  estadoValidacion   EstadoValidacionAsistencia @default(PENDIENTE)

  entradaLatitud         Decimal? @db.Decimal(10, 7)
  entradaLongitud        Decimal? @db.Decimal(10, 7)
  entradaPrecisionMetros Float?
  entradaIp              String?  @db.VarChar(45)

  salidaLatitud         Decimal? @db.Decimal(10, 7)
  salidaLongitud        Decimal? @db.Decimal(10, 7)
  salidaPrecisionMetros Float?
  salidaIp              String?  @db.VarChar(45)

  operaciones OperacionIdempotenteAsistencia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, openSlot])
  @@index([usuarioId, entradaAt])
  @@index([sedeId, entradaAt])
  @@index([areaId, entradaAt])
  @@index([estado, entradaAt])
}

model OperacionIdempotenteAsistencia {
  id String @id @default(uuid()) @db.Char(36)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  asistenciaId String     @db.Char(36)
  asistencia   Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Restrict)

  tipo            TipoOperacionAsistencia
  clave           String                  @db.VarChar(128)
  huellaSolicitud String                  @db.Char(64)

  createdAt DateTime @default(now())

  @@unique([usuarioId, tipo, clave])
  @@index([asistenciaId])
}

model EventoAuditoria {
  id BigInt @id @default(autoincrement())

  actorUsuarioId Int?
  actorUsuario   Usuario?    @relation(fields: [actorUsuarioId], references: [id], onDelete: SetNull)
  actorRol       RolUsuario?
  actorAlcance   String?     @db.VarChar(20)

  correlacionId   String  @db.Char(36)
  accion          String  @db.VarChar(100)
  objetoTipo      String  @db.VarChar(80)
  objetoId        String? @db.VarChar(191)
  resultado       String  @db.VarChar(40)
  motivo          String? @db.VarChar(255)
  diffPermitido   Json?
  versionPolitica String? @db.VarChar(80)

  createdAt DateTime @default(now())

  @@index([actorUsuarioId, createdAt])
  @@index([objetoTipo, objetoId, createdAt])
  @@index([correlacionId])
}
