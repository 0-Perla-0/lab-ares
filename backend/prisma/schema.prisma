generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum RolUsuario {
  PRESTADOR
  COORDINADOR
  JEFE_COORDINADORES
  JEFE_AREA
  JEFE_SEDE
  ADMIN
}

enum EstadoUsuario {
  INVITADA
  ACTIVA
  SUSPENDIDA
  DESACTIVADA
  BLOQUEADA
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum EstadoAdscripcionAcademica {
  PENDIENTE_CONFIRMACION
  CONFIRMADA
  RECHAZADA
}

model Sede {
  id        Int     @id @default(autoincrement())
  nombre    String  @unique @db.VarChar(150)
  direccion String? @db.VarChar(255)

  activa Boolean @default(true)

  areas    Area[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Area {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(150)

  activa Boolean @default(true)

  sedeId Int
  sede   Sede @relation(fields: [sedeId], references: [id], onDelete: Restrict)

  turnos   Turno[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sedeId, nombre])
  @@index([sedeId])
}

model Turno {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(100)

  horaInicio DateTime @db.Time(0)
  horaFin    DateTime @db.Time(0)

  activo Boolean @default(true)

  areaId Int
  area   Area @relation(fields: [areaId], references: [id], onDelete: Restrict)

  dias     TurnoDia[]
  usuarios Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaId, nombre])
  @@index([areaId])
}

model TurnoDia {
  turnoId Int
  dia     DiaSemana

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@id([turnoId, dia])
}

model Usuario {
  id Int @id @default(autoincrement())

  codigo String @unique @db.VarChar(50)
  email  String @unique @db.VarChar(191)

  passwordHash String @db.VarChar(255)

  rol    RolUsuario    @default(PRESTADOR)
  estado EstadoUsuario @default(INVITADA)

  sedeId  Int?
  areaId  Int?
  turnoId Int?

  sede  Sede?  @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  area  Area?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  turno Turno? @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  asistencias Asistencia[]
  sessions Session[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  invitationsTarget Invitation[] @relation("InvitationTarget")
  recoveryTokens RecoveryToken[]
  mfa UserMfa?
  mfaChallenges MfaChallenge[]
  recoveryCodes MfaRecoveryCode[]
  notifications Notification[]
  adscripcionesAcademicas AdscripcionAcademica[]
  solicitudesAcademicas AdscripcionAcademica[] @relation("AcademicRequester")
  confirmacionesAcademicas AdscripcionAcademica[] @relation("AcademicConfirmer")
  requisitosDocumentales RequisitoDocumento[]
  documentosCargados DocumentoVersion[] @relation("DocumentoUploader")
  documentosRevisados DocumentoVersion[] @relation("DocumentoReviewer")
  kairosProjectsCreated ProyectoKairos[] @relation("KairosProjectCreator")
  kairosMemberships MiembroProyectoKairos[]
  kairosFavorites FavoritoProyectoKairos[]
  kairosActivitiesResponsible ActividadKairos[] @relation("KairosActivityResponsible")
  kairosActivityParticipants ParticipanteActividadKairos[]
  kairosEvidenceAuthors EntregaEvidenciaKairos[]
  kairosActivityComments ComentarioActividadKairos[]
  kairosActivityReviews HistorialActividadKairos[] @relation("KairosActivityReviewer")
  kairosActivityHistory HistorialActividadKairos[] @relation("KairosActivityActor")
  archivosPropiedad Archivo[] @relation("ArchivoOwner")
  directorioPreferencia DirectorioPreferencia?
  reportExportsRequested ReporteExportacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rol])
  @@index([estado])
  @@index([sedeId])
  @@index([areaId])
  @@index([turnoId])
}

model DirectorioPreferencia {
  usuarioId Int @id
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  visibleEnArea Boolean @default(true)
  visibleEnProyectos Boolean @default(true)
  mostrarEmail Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model InstitucionAcademica {
  id Int @id @default(autoincrement())
  nombre String @unique @db.VarChar(191)
  activa Boolean @default(true)
  unidades UnidadAcademica[]
  adscripciones AdscripcionAcademica[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([activa])
}

model UnidadAcademica {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(191)
  activa Boolean @default(true)
  institucionId Int
  institucion InstitucionAcademica @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  programas ProgramaAcademico[]
  adscripciones AdscripcionAcademica[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([institucionId, nombre])
  @@index([institucionId, activa])
}

model ProgramaAcademico {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(191)
  activa Boolean @default(true)
  unidadAcademicaId Int
  unidadAcademica UnidadAcademica @relation(fields: [unidadAcademicaId], references: [id], onDelete: Restrict)
  adscripciones AdscripcionAcademica[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([unidadAcademicaId, nombre])
  @@index([unidadAcademicaId, activa])
}

model CohorteAcademica {
  id Int @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)
  activa Boolean @default(true)
  adscripciones AdscripcionAcademica[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([activa])
}

model AdscripcionAcademica {
  id Int @id @default(autoincrement())
  usuarioId Int
  institucionId Int
  unidadAcademicaId Int?
  programaAcademicoId Int
  cohorteId Int?
  inicio DateTime @db.Date
  fin DateTime? @db.Date
  vigente Boolean @default(true)
  estado EstadoAdscripcionAcademica @default(PENDIENTE_CONFIRMACION)
  motivoRechazo String? @db.VarChar(500)
  solicitadoPorId Int?
  confirmadoPorId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  institucion InstitucionAcademica @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  unidadAcademica UnidadAcademica? @relation(fields: [unidadAcademicaId], references: [id], onDelete: Restrict)
  programaAcademico ProgramaAcademico @relation(fields: [programaAcademicoId], references: [id], onDelete: Restrict)
  cohorte CohorteAcademica? @relation(fields: [cohorteId], references: [id], onDelete: Restrict)
  solicitadoPor Usuario? @relation("AcademicRequester", fields: [solicitadoPorId], references: [id], onDelete: SetNull)
  confirmadoPor Usuario? @relation("AcademicConfirmer", fields: [confirmadoPorId], references: [id], onDelete: SetNull)
  @@index([usuarioId, vigente, inicio])
  @@index([institucionId, programaAcademicoId])
}

model Session {
  id        String   @id @db.VarChar(191)
  data      Json
  expiresAt DateTime
  userId Int?
  user Usuario? @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastActivityAt DateTime @default(now())
  absoluteExpiresAt DateTime
  revokedAt DateTime?
  ipHash String? @db.Char(64)
  userAgentSummary String? @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model Invitation {
  id String @id @default(cuid()) @db.VarChar(30)
  tokenHash String @unique @db.Char(64)
  targetEmail String @db.VarChar(191)
  targetUserId Int?
  targetUser Usuario? @relation("InvitationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  role RolUsuario
  sedeId Int?
  areaId Int?
  turnoId Int?
  expiresAt DateTime
  usedAt DateTime?
  revokedAt DateTime?
  createdById Int
  createdBy Usuario @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedById Int?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([targetEmail, expiresAt])
  @@index([createdById])
  @@index([archivedAt])
}

model RecoveryToken {
  id String @id @default(cuid()) @db.VarChar(30)
  tokenHash String @unique @db.Char(64)
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model UserMfa {
  userId Int @id
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretCiphertext String @db.Text
  enabledAt DateTime?
  lastAcceptedStep BigInt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MfaChallenge {
  id String @id @default(cuid()) @db.VarChar(30)
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime
  attempts Int @default(0)
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model MfaRecoveryCode {
  id String @id @default(cuid()) @db.VarChar(30)
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @unique @db.Char(64)
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, usedAt])
}

model Notification {
  id String @id @default(cuid()) @db.VarChar(30)
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)
  type String @db.VarChar(100)
  payload Json
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
}

model OutboxEvent {
  id String @id @default(cuid()) @db.VarChar(30)
  type String @db.VarChar(100)
  aggregateId String @db.VarChar(100)
  payload Json
  occurredAt DateTime @default(now())
  processedAt DateTime?
  attempts Int @default(0)
  state String @default("PENDING") @db.VarChar(20)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseOwner String? @db.VarChar(80)
  lastError String? @db.VarChar(500)
  failedAt DateTime?
  emailDeliveries EmailDelivery[]
  @@index([processedAt, occurredAt])
}

model EmailDelivery {
  id String @id @default(cuid()) @db.VarChar(30)
  outboxEventId String @unique
  event OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  status String @db.VarChar(20)
  attempts Int @default(0)
  errorRedacted String? @db.VarChar(500)
  sentAt DateTime?
  messageId String @unique @db.VarChar(180)
  leaseUntil DateTime?
  leaseOwner String? @db.VarChar(80)
  createdAt DateTime @default(now())
  @@index([status, leaseUntil])
}

model AuditEvent {
  id String @id @default(cuid()) @db.VarChar(30)
  actorId Int?
  subjectId Int?
  action String @db.VarChar(100)
  resource String @db.VarChar(100)
  correlationId String? @db.VarChar(100)
  metadata Json?
  occurredAt DateTime @default(now())
  @@index([resource, subjectId, occurredAt])
  @@index([actorId, occurredAt])
}

enum TipoReporteExportacion {
  ATTENDANCE
  DOCUMENTS
  KAIROS
}
enum EstadoReporteExportacion {
  PENDIENTE
  GENERANDO
  COMPLETADO
  FALLIDO
  EXPIRADO
}
model ReporteExportacion {
  id String @id @default(cuid()) @db.VarChar(30)
  requesterId Int
  requester Usuario @relation(fields:[requesterId], references:[id], onDelete:Restrict)
  type TipoReporteExportacion
  filters Json
  totalFilas Int @default(0)
  archivoId String? @unique @db.VarChar(30)
  archivo Archivo? @relation(fields:[archivoId], references:[id], onDelete:SetNull)
  status EstadoReporteExportacion @default(PENDIENTE)
  leaseOwner String? @db.VarChar(80)
  leaseUntil DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime?
  errorCode String? @db.VarChar(100)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([requesterId, createdAt])
  @@index([status, leaseUntil, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([expiresAt, status])
}

enum EstadoArchivo {
  RECIBIDO
  PENDIENTE_ANALISIS
  ANALIZANDO
  DISPONIBLE
  RECHAZADO
  ERROR_ANALISIS
  ELIMINADO
}

enum ResultadoAnalisisArchivo {
  LIMPIO
  INFECTADO
  ERROR
}

model Archivo {
  id              String       @id @default(cuid()) @db.VarChar(30)
  propietarioId   Int?
  propietario     Usuario? @relation("ArchivoOwner", fields:[propietarioId], references:[id], onDelete:SetNull)
  objectKey       String       @unique @db.VarChar(500)
  quarantineKey   String       @unique @db.VarChar(500)
  originalName    String       @db.VarChar(255)
  detectedMime    String?      @db.VarChar(150)
  extension       String?      @db.VarChar(20)
  sizeBytes       BigInt
  sha256          String?      @db.Char(64)
  status          EstadoArchivo @default(RECIBIDO)
  analysisAttempts Int         @default(0)
  analysisExhaustedAt DateTime?
  nextAttemptAt   DateTime?
  leaseUntil      DateTime?
  leaseOwner      String?       @db.VarChar(80)
  lastError       String?      @db.VarChar(1000)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  analyses        AnalisisArchivo[]
  documentoVersiones DocumentoVersion[]
  kairosEvidence EntregaEvidenciaKairos[]
  reportExports ReporteExportacion[]

  @@index([status, nextAttemptAt])
  @@index([leaseUntil])
  @@index([propietarioId])
}

enum EstadoDocumento {
  PENDIENTE_CARGA
  EN_REVISION
  AUTORIZADO
  RECHAZADO
  REQUIERE_CORRECCION
  VENCIDO
  CANCELADO
}

model RequisitoDocumento {
  id Int @id @default(autoincrement())
  usuarioId Int
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  codigo String @db.VarChar(80)
  nombre String @db.VarChar(191)
  obligatorio Boolean @default(true)
  activo Boolean @default(true)
  versiones DocumentoVersion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([usuarioId, codigo])
  @@index([usuarioId, activo])
}

model DocumentoVersion {
  id String @id @default(cuid()) @db.VarChar(30)
  requisitoId Int
  requisito RequisitoDocumento @relation(fields: [requisitoId], references: [id], onDelete: Restrict)
  archivoId String
  archivo Archivo @relation(fields: [archivoId], references: [id], onDelete: Restrict)
  version Int
  estado EstadoDocumento @default(PENDIENTE_CARGA)
  comentario String? @db.VarChar(1000)
  cargadoPorId Int
  cargadoPor Usuario @relation("DocumentoUploader", fields: [cargadoPorId], references: [id], onDelete: Restrict)
  revisadoPorId Int?
  revisadoPor Usuario? @relation("DocumentoReviewer", fields: [revisadoPorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([requisitoId, version])
  @@index([requisitoId, estado, createdAt])
}

model AnalisisArchivo {
  id        String                    @id @default(cuid()) @db.VarChar(30)
  archivoId String
  archivo   Archivo                   @relation(fields: [archivoId], references: [id], onDelete: Cascade)
  scanner   String                    @db.VarChar(50)
  resultado ResultadoAnalisisArchivo
  signature String?                   @db.VarChar(255)
  error     String?                   @db.VarChar(1000)
  startedAt DateTime                  @default(now())
  finishedAt DateTime?

  @@index([archivoId, startedAt])
}

enum EstadoAsistencia {
  ABIERTA
  PENDIENTE
  AUTORIZADA
  RECHAZADA
}

enum EstadoProyectoKairos {
  BORRADOR
  ACTIVO
  ARCHIVADO
}

enum PrioridadProyectoKairos {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum RolMiembroProyectoKairos {
  PROPIETARIO
  SUBLIDER
  COLABORADOR
  OBSERVADOR
}

model ProyectoKairos {
  id          String @id @default(cuid()) @db.VarChar(30)
  nombre      String @db.VarChar(191)
  descripcion String? @db.VarChar(1000)
  estado      EstadoProyectoKairos @default(BORRADOR)
  prioridad   PrioridadProyectoKairos @default(MEDIA)
  creadoPorId Int
  creadoPor   Usuario @relation("KairosProjectCreator", fields: [creadoPorId], references: [id], onDelete: Restrict)
  miembros    MiembroProyectoKairos[]
  favoritos   FavoritoProyectoKairos[]
  activities ActividadKairos[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([estado, prioridad, updatedAt])
  @@index([creadoPorId, createdAt])
}

model MiembroProyectoKairos {
  proyectoId String @db.VarChar(30)
  usuarioId  Int
  rol        RolMiembroProyectoKairos
  proyecto   ProyectoKairos @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  removedAt  DateTime?

  @@id([proyectoId, usuarioId])
  @@index([usuarioId, rol])
  @@index([proyectoId, rol])
}

model FavoritoProyectoKairos {
  proyectoId String @db.VarChar(30)
  usuarioId  Int
  proyecto   ProyectoKairos @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  usuario    Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([proyectoId, usuarioId])
  @@index([usuarioId, createdAt])
}

enum EstadoActividadKairos {
  PENDIENTE
  EN_PROGRESO
  BLOQUEADA
  EN_REVISION
  REQUIERE_CORRECCION
  TERMINADA
  CANCELADA
}
enum PrioridadActividadKairos {
  BAJA
  MEDIA
  ALTA
  CRITICA
}
enum ComplejidadActividadKairos {
  BAJA
  MEDIA
  ALTA
}
enum TipoHistorialActividadKairos {
  TRANSICION
  REVISION
  REAPERTURA
  ENTREGA
}

model ActividadKairos {
  id String @id @default(cuid()) @db.VarChar(30)
  proyectoId String @db.VarChar(30)
  responsableId Int
  title String @db.VarChar(191)
  description String? @db.VarChar(3000)
  startAt DateTime?
  dueAt DateTime?
  closedAt DateTime?
  priority PrioridadActividadKairos @default(MEDIA)
  complexity ComplejidadActividadKairos @default(MEDIA)
  state EstadoActividadKairos @default(PENDIENTE)
  proyecto ProyectoKairos @relation(fields:[proyectoId], references:[id], onDelete: Cascade)
  responsable Usuario @relation("KairosActivityResponsible", fields:[responsableId], references:[id], onDelete: Restrict)
  participants ParticipanteActividadKairos[]
  evidence EntregaEvidenciaKairos[]
  comments ComentarioActividadKairos[]
  history HistorialActividadKairos[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([proyectoId,state,dueAt])
  @@index([responsableId,state])
}
model ParticipanteActividadKairos {
  actividadId String @db.VarChar(30)
  usuarioId Int
  actividad ActividadKairos @relation(fields:[actividadId], references:[id], onDelete: Cascade)
  usuario Usuario @relation(fields:[usuarioId], references:[id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@id([actividadId,usuarioId])
}
model EntregaEvidenciaKairos {
  id String @id @default(cuid()) @db.VarChar(30)
  actividadId String @db.VarChar(30)
  archivoId String @db.VarChar(30)
  authorId Int
  version Int
  comment String? @db.VarChar(1000)
  actividad ActividadKairos @relation(fields:[actividadId], references:[id], onDelete: Cascade)
  archivo Archivo @relation(fields:[archivoId], references:[id], onDelete: Restrict)
  author Usuario @relation(fields:[authorId], references:[id], onDelete: Restrict)
  createdAt DateTime @default(now())
  histories HistorialActividadKairos[]
  @@unique([actividadId,version])
  @@index([archivoId])
}
model ComentarioActividadKairos {
  id String @id @default(cuid()) @db.VarChar(30)
  actividadId String @db.VarChar(30)
  authorId Int
  body String @db.VarChar(2000)
  actividad ActividadKairos @relation(fields:[actividadId], references:[id], onDelete: Cascade)
  author Usuario @relation(fields:[authorId], references:[id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([actividadId,createdAt])
}
model HistorialActividadKairos {
  id String @id @default(cuid()) @db.VarChar(30)
  actividadId String @db.VarChar(30)
  actorId Int
  reviewerId Int?
  type TipoHistorialActividadKairos
  fromState EstadoActividadKairos?
  toState EstadoActividadKairos?
  comment String? @db.VarChar(2000)
  evidenceId String? @db.VarChar(30)
  evidence EntregaEvidenciaKairos? @relation(fields:[evidenceId], references:[id], onDelete: Restrict)
  actividad ActividadKairos @relation(fields:[actividadId], references:[id], onDelete: Cascade)
  actor Usuario @relation("KairosActivityActor", fields:[actorId], references:[id], onDelete: Restrict)
  reviewer Usuario? @relation("KairosActivityReviewer", fields:[reviewerId], references:[id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([actividadId,createdAt])
}

model Asistencia {
  id Int @id @default(autoincrement())
  userId Int
  user Usuario @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // NULL after closing. A unique nullable key enforces one open interval per user.
  openUserId Int? @unique
  // Organizational assignment at check-in, retained even after a transfer.
  sedeId Int
  areaId Int
  turnoId Int
  checkInAt DateTime @db.DateTime(3)
  checkOutAt DateTime? @db.DateTime(3)
  durationSeconds Int?
  status EstadoAsistencia @default(ABIERTA)
  closeReason String? @db.VarChar(500)
  closedById Int?
  events AsistenciaEvento[]

  @@index([userId, id])
  @@index([status, areaId, id])
  @@index([status, sedeId, id])
}

model AsistenciaEvento {
  id Int @id @default(autoincrement())
  attendanceId Int
  attendance Asistencia @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  actorId Int
  action String @db.VarChar(30)
  occurredAt DateTime @db.DateTime(3)
  reason String? @db.VarChar(500)

  @@index([attendanceId, id])
}

model AsistenciaSolicitud {
  actorId Int
  key String @db.VarChar(100)
  fingerprint String @db.Char(64)
  response Json
  createdAt DateTime @default(now())

  @@id([actorId, key])
}
