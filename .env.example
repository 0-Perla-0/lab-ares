# Database
# Replace CHANGE_ME before running Prisma. Use a password-authenticated app user.
DATABASE_URL=mysql://ares_app:CHANGE_ME@localhost:3306/ares_dev

# Backend and browser origin
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:4321
APP_TIME_ZONE=America/Mexico_City
SESSION_SECRET=replace-this-with-at-least-32-random-characters

# One-time recovery/bootstrap command: npm run admin:bootstrap
# BOOTSTRAP_ADMIN_CODE=ADMIN001
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
