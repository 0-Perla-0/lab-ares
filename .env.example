# Database
# Replace CHANGE_ME before running Prisma. Use a password-authenticated app user.
DATABASE_URL=mysql://ares_app:CHANGE_ME@localhost:3307/ares_dev
MARIADB_HOST_PORT=3307
# Set true for verified TLS; do not use ssl/rejectUnauthorized URL query options.
DATABASE_TLS_ENABLED=false
# DATABASE_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_TLS_SERVERNAME=db.example.org

# Backend and browser origin
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:4321
APP_TIME_ZONE=America/Mexico_City
# Advisory alert only; never closes an interval or validates hours.
ATTENDANCE_ALERT_HOURS=12
ATTENDANCE_WORKER_ENABLED=false
ABSENCE_WORKER_ENABLED=false
# Optional first civil date to evaluate; without it evaluation starts yesterday.
# ABSENCE_EVALUATION_START_DATE=2026-10-10
SESSION_SECRET=replace-this-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-this-with-a-different-32-character-random-key
OUTBOX_ENCRYPTION_KEY=replace-this-with-another-32-character-random-key

# Private S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
# Object deletion is fail-closed unless PRIVATE buckets have versioning Enabled.
# Keep historical signing keys through reviewed rotation; never put real keys here.
OBJECT_DELETION_HMAC_KEYRING=
# Browser-reachable endpoint for signing; keep S3_ENDPOINT internal if proxied.
# HTTPS and a signature-preserving proxy are required in production.
S3_DOWNLOAD_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ares-local
S3_SECRET_KEY=ares-local-secret
S3_FORCE_PATH_STYLE=true
S3_QUARANTINE_BUCKET=ares-quarantine
S3_AVAILABLE_BUCKET=ares-available
S3_PUBLIC_BUCKET=ares-public
S3_SUPPRESSION_JOURNAL_BUCKET=ares-suppression-journal
SUPPRESSION_JOURNAL_HMAC_SECRET=replace-this-with-at-least-32-random-characters
SUPPRESSION_JOURNAL_KEY_VERSION=v1
SUPPRESSION_JOURNAL_WORKER_ENABLED=false
SUPPRESSION_JOURNAL_WORKER_INTERVAL_MS=60000
RECOVERY_RECONCILIATION_MAX_ATTEMPTS=3
RECOVERY_RECONCILIATION_LEASE_MS=120000
STORAGE_MAX_BYTES=52428800
# Replica-local ceiling includes spools awaiting domain processing; provision disk/proxy quotas too.
STORAGE_MAX_CONCURRENT_UPLOADS=4
LIBRARY_MAX_BYTES=26214400
GAMIFICATION_ENABLED=false
GAMIFICATION_POINTS_PER_LEVEL=100
PRINTING_3D_ENABLED=false
RETENTION_INSTITUTIONAL_POLICIES_APPROVED=false
RETENTION_WORKER_ENABLED=false
RETENTION_WORKER_INTERVAL_MS=60000
RETENTION_BATCH_SIZE=20
RETENTION_MAX_ATTEMPTS=3
RETENTION_LEASE_MS=120000
RETENTION_RETRY_BASE_MS=60000
AUDIT_MANIFEST_WORKER_ENABLED=false
AUDIT_MANIFEST_WORKER_INTERVAL_MS=3600000
OPERATIONS_JOB_MAX_ATTEMPTS=3
OPERATIONS_JOB_LEASE_MS=120000
OPERATIONS_RETRY_BASE_MS=60000
# No invented SLOs or automatic activation: publish reviewed seconds explicitly.
OPERATIONS_QUEUE_MONITOR_ENABLED=false
OPERATIONS_QUEUE_MONITOR_INTERVAL_MS=60000
OPERATIONS_QUEUE_SLO_JSON={}
# OPERATIONS_QUEUE_SLO_JSON={"outbox":300,"storage":600,"reports":900,"retention":900,"suppressionJournal":900}
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
STORAGE_SCANNER_ENABLED=false
REPORTS_WORKER_ENABLED=true
REPORTS_WORKER_INTERVAL_MS=60000
REPORTS_BATCH_SIZE=10
REPORTS_MAX_ATTEMPTS=3
# Technical spool ceiling, not an institutional retention policy (256 MiB).
REPORTS_MAX_BYTES=268435456
REPORTS_LEASE_MS=120000
REPORTS_RETRY_BASE_MS=60000

# Local transactional email (Mailpit in Docker Compose)
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@ares.local
SMTP_TLS=false
OUTBOX_WORKER_ENABLED=true

# One-time recovery/bootstrap command: npm run admin:bootstrap
# BOOTSTRAP_ADMIN_CODE=ADMIN001
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
TRUSTED_PROXY_CIDRS=
VISITS_ENABLED=false
INVENTORY_ENABLED=false
VISITS_TOKEN_KEY=development-only-visits-token-key-change-me
VISITS_TOKEN_ACTIVE_VERSION=legacy
# JSON of version -> dedicated key; include legacy during the first rotation.
# VISITS_TOKEN_KEYRING={"legacy":"old-dedicated-key-32-characters-minimum","v2":"new-dedicated-key-32-characters-minimum"}
VISITS_TOKEN_KEYRING=
INVENTORY_CHECK_WORKER_ENABLED=false
INVENTORY_CHECK_INTERVAL_MS=300000
# Empty lists preserve current scope. Non-empty lists intersect with RBAC.
OPERATIONAL_PILOT_SEDE_IDS=
OPERATIONAL_PILOT_AREA_IDS=
# Dedicated Compose runtime account; migrations continue using ares_app.
# Replace with random base64url (32-128 chars), and URL-encode migration secrets.
RUNTIME_DB_PASSWORD=development_runtime_password_change_me_32
# ARES_DATABASE_NAME=ares_dev
## Optional reviewed offline SHA-256 password denylist, comma separated; no passwords are sent externally.
PASSWORD_DENY_SHA256=
# Optional reviewed read-only newline-delimited hash corpus (<=32 MiB).
# Both absolute path and exact approved file checksum are required; no plaintext.
# PASSWORD_DENY_FILE=/run/ares/password-deny.sha256
# PASSWORD_DENY_FILE_SHA256=<64-character SHA-256 of the exact file bytes>
