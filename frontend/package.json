{
  "name": "@ares/frontend",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 4321",
    "check": "tsc --noEmit",
    "lint:a11y": "eslint app components --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "build": "next build",
    "start": "next start --port 4321",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"fullstack/**/*.ts\" \"playwright*.ts\" \"vitest.config.ts\" \"*.{mjs,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"fullstack/**/*.ts\" \"playwright*.ts\" \"vitest.config.ts\" \"*.{mjs,json}\""
  },
  "dependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.542.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "mariadb": "^3.5.4",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.10"
  }
}
