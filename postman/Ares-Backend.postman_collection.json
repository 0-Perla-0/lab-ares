          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Sede actualizada\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().data.direccion).to.eql(null);",
                  "});"
                ]
              }
            }
