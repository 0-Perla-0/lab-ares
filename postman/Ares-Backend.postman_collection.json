    {
      "name": "05 - Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"USR{{runSuffix}}\",\n  \"email\": \"postman.{{runSuffix}}@ares.local\",\n  \"password\": \"Postman-Test-Password-123!\",\n  \"rol\": \"PRESTADOR\",\n  \"estado\": \"ACTIVO\",\n  \"sedeId\": {{sedeId}},\n  \"areaId\": {{areaId}},\n  \"turnoId\": {{turnoId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users",
            "description": "Crea un usuario dentro de la jerarquía generada por la colección. La contraseña se almacena únicamente como hash."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Usuario creado sin datos sensibles\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const user = pm.response.json().data;",
                  "    pm.expect(user.codigo).to.eql(\"USR\" + pm.collectionVariables.get(\"runSuffix\"));",
                  "    pm.expect(user.email).to.eql(\"postman.\" + pm.collectionVariables.get(\"runSuffix\") + \"@ares.local\");",
                  "    pm.expect(user).not.to.have.property(\"passwordHash\");",
                  "    pm.expect(user).not.to.have.property(\"password\");",
                  "    pm.collectionVariables.set(\"userId\", String(user.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazar usuario duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"USR{{runSuffix}}\",\n  \"email\": \"postman.{{runSuffix}}@ares.local\",\n  \"password\": \"Postman-Test-Password-123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users",
            "description": "Prueba negativa: codigo y email son únicos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El código duplicado produce conflicto\", function () {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json()).to.eql({ error: \"USER_CODE_ALREADY_EXISTS\" });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "description": "ADMIN ve todos los usuarios que no están en BAJA. Otros roles reciben solo su área o sede según RBAC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El usuario aparece en el listado\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const users = pm.response.json().data;",
                  "    const user = users.find((item) => String(item.id) === pm.collectionVariables.get(\"userId\"));",
                  "    pm.expect(user).to.be.an(\"object\");",
                  "    pm.expect(user).not.to.have.property(\"passwordHash\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Obtiene un usuario por id dentro del alcance autorizado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Usuario encontrado\", function () {",
                  "    pm.response.to.have.status(200);",
