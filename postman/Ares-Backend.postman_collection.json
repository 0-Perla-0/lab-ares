  "item": [
    {
      "name": "00 - Públicos",
      "item": [
        {
          "name": "Health - disponibilidad",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/health",
            "description": "Comprueba proceso y conexión a la base de datos. Espera 200 o 503 si MariaDB no está disponible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Backend y base de datos disponibles\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql({ status: \"ok\", database: \"connected\" });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health - liveness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/health/live",
            "description": "Comprueba únicamente que el proceso de NestJS está vivo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Proceso vivo\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql({ status: \"ok\" });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health - readiness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/health/ready",
            "description": "Comprueba que el backend está listo y MariaDB responde."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Backend listo\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.eql({ status: \"ok\", database: \"connected\" });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Contrato OpenAPI",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/docs/openapi.json",
            "description": "Devuelve el contrato OpenAPI 3.1 generado por el backend."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Contrato OpenAPI válido\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.openapi).to.eql(\"3.1.0\");",
                  "    pm.expect(body.paths).to.have.property(\"/api/auth/login\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Iniciar sesión como administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Crea una sesión persistida. Postman guarda automáticamente la cookie HTTP-only `ares-session`."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runSuffix\", Date.now().toString());",
                  "pm.collectionVariables.unset(\"sedeId\");",
                  "pm.collectionVariables.unset(\"areaId\");",
                  "pm.collectionVariables.unset(\"turnoId\");",
                  "pm.collectionVariables.unset(\"userId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Sesión creada\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.rol).to.eql(\"ADMIN\");",
                  "    pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"ares-session=\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener usuario actual",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Requiere la cookie de sesión. Devuelve el usuario autenticado sin passwordHash."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Usuario administrador autenticado\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const user = pm.response.json().data;",
                  "    pm.expect(user.rol).to.eql(\"ADMIN\");",
                  "    pm.expect(user).not.to.have.property(\"passwordHash\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
