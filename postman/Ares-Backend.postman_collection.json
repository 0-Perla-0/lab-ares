{
  "info": {
    "_postman_id": "2cb80208-1f56-4df5-82c4-0fd6427c32cd",
    "name": "Ares Backend API",
    "description": "Colección local de los endpoints disponibles en Ares. Ejecútala en orden: inicia sesión, crea la jerarquía Sede → Área → Turno, prueba el CRUD de usuarios y los CRUD lógicos, y termina destruyendo la sesión.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"La respuesta no expone caché privada\", function () {",
          "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
          "});"
        ]
      }
    }
  ],
