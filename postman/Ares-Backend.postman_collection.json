                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sede Postman actualizada {{runSuffix}}\",\n  \"direccion\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/organization/sedes/{{sedeId}}",
            "description": "El cuerpo es parcial, pero debe contener al menos una propiedad."
