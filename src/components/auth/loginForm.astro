---
---

<form id="login-form" class="space-y-6">
    <div>
        <label
        for="email"
        class="block text-md font-medium text-gray-700 "
        >
        Correo electrónico
        </label>

        <input
            type="email"
            name="email"
            id="email"
            placeholder="  inventor@alumnos.udg.mx"
            required
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm h-8"
        />
    </div>

    <div>
        <div class="flex items-center justify-between">
            <label
            for="password"
            class="block text-md font-medium text-slate-700">
                Contraseña
            </label>

            <a
                href="#"
                class="text-sm font-semibold text-sky-600 hover:text-sky-500"
            >
                ¿Olvidaste tu contraseña?
            </a>
        </div>

        <input
            type="password"
            name="password"
            id="password"
            autocomplete="current-password"
            placeholder="  ********"
            required
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm h-8"
        />
    </div>

    <div
        id="login-error"
        class="hidden rounded-lg border border-red-200 bg-red-100 p-4 px-4 py-3 text-sm text-red-600"
        role="alert"
        >
        Las credenciales no son correctas. Por favor, inténtalo de nuevo.
    </div>
    <button
        type="submit"
        class="w-full rounnded-lg bg-slate-900 px-4 py-3 text-sm font semibold text-white transition hover:bg-slate-700 border border-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2"
    >
        Iniciar sesión
    </button>
</form>
