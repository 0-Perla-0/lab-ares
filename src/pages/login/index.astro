---
import AuthLayout from "../../layouts/authLayout.astro";
import LoginForm from "../../components/auth/loginForm.astro";
---

<AuthLayout
    title="Iniciar sesion">
    <div class="grid min-h-screen lg:grid-cols-2">

        <!--panel de información -->
        <section class="hidden bg-slate-900 p-12 text-white lg:flex lg:flex-col lg:justify-between">
            <div>
                <a 
                href="/"
                class="text-xl font-bold tracking-tight"
                >
                Laboratorio de Inventores
            </a>
            </div>

            <div class="mas-w-lg">
                <p class="text-sm font-semibold tracking-wider text-slate-400">
                    ¡Bienvenido!
                </p>

                <h1 class="mt-4 text-4xl font-bold tracking-tight">
                    Bienvenido de nuevo, <span class="text-blue-500"> Inventor </span>
                </h1>

                <p class="mt-6 leading-7 text-slate-400">
                    Ingresa tus credenciales
                </p>
            </div>

            <p class="text-sm text-slate-500">
                © {new Date().getFullYear()} Laboratorio de inventores.
            </p>    

        </section>

        <!--Formulario-->
        <section class="flex flex-col justify-center px-6 py-6 sm:px-10">
            <div class="w-full max-w-md"> 
                
                <span class="text-2xl font-bold tracking-tight text-orange-600"
                >
                    Laboratorio de Inventores
                </span>
            </div>

            <div>
                <h2 class="text-3xl font-bold tracking-tight text-slate-900">
                    Bienvenido de nuevo, por favor inicia sesión
                </h2>

                <p class="mt-2 text-sm text-slate-600">
                    Ingresa tus credenciales 
                </p>
            </div>

            <div class="mt-8">
                <LoginForm />
            </div>

        </section>

    </div>
</AuthLayout>
