---
import PublicLayout from "../layouts/publicLayout.astro";
---

<PublicLayout
    title="Mi Empresa"
    description="Bienvenido a Mi Empresa"
>
    <!-- Hero -->
    <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">

        <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-wider text-slate-600">
            Bienvenido
        </p>

        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl">
            Una plataforma pensada para simplificar tu trabajo.
        </h1>

        <p class="mt-6 text-lg leading-8 text-slate-600">
            Aquí podremos explicar brevemente qué hace nuestra empresa,
            qué problema resolvemos y por qué deberían utilizar nuestra
            plataforma.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">

            <a
            href="/login"
            class="rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-700"
            >
            Acceder al portal
            </a>

            <a
            href="#servicios"
            class="rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-900 transition hover:bg-white"
            >
            Conocer más
            </a>

        </div>

        </div>

    </div>
    </section>


    <!-- Servicios -->
    <section id="servicios" class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">
            ¿Qué ofrecemos?
        </h2>

        <p class="mt-4 text-slate-600">
            Una breve introducción a los principales servicios o
            funcionalidades.
        </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">

        <article class="rounded-xl border border-slate-200 p-6">
            <h3 class="text-lg font-semibold">
            Servicio 1
            </h3>

            <p class="mt-3 text-sm leading-6 text-slate-600">
            Descripción del servicio.
            </p>
        </article>

        <article class="rounded-xl border border-slate-200 p-6">
            <h3 class="text-lg font-semibold">
            Servicio 2
            </h3>

            <p class="mt-3 text-sm leading-6 text-slate-600">
            Descripción del servicio.
            </p>
        </article>

        <article class="rounded-xl border border-slate-200 p-6">
            <h3 class="text-lg font-semibold">
            Servicio 3
            </h3>
        
            <p class="mt-3 text-sm leading-6 text-slate-600">
            Descripción del servicio.
            </p>
        </article>

        </div>

    </div>
    </section>


    <!-- Nosotros -->
    <section id="nosotros" class="bg-slate-50 py-24">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">

        <h2 class="text-3xl font-bold tracking-tight text-slate-900">
        Sobre nosotros
        </h2>

        <p class="mt-6 leading-8 text-slate-600">
        Aquí podremos colocar la información institucional,
        misión, visión, experiencia, etc.
        </p>

    </div>
    </section>


    <!-- Contacto -->
    <section id="contacto" class="py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">

        <h2 class="text-3xl font-bold tracking-tight text-slate-900">
        ¿Tienes alguna pregunta?
        </h2>

        <p class="mt-4 text-slate-600">
        Ponte en contacto con nosotros.
        </p>

        <a
        href="mailto:contacto@ejemplo.com"
        class="mt-8 inline-block rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700"
        >
        Contactarnos
        </a>

    </div>
    </section>

</PublicLayout>