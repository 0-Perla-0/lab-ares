{
  "name": "ares",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "concurrently --kill-others --names backend,frontend --prefix-colors cyan,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace @ares/frontend",
    "dev:backend": "npm run start:dev --workspace @ares/backend",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @ares/backend",
    "test:e2e": "npm run e2e --workspace @ares/frontend",
    "test:e2e:fullstack": "npm exec --workspace @ares/frontend -- playwright test --config playwright.fullstack.config.ts",
    "docs:check": "node --test scripts/docs-policy.test.mjs && node scripts/check-docs.mjs",
    "prisma:drift:check": "npm run prisma:drift:check --workspace @ares/backend",
    "quality": "npm run docs:check && npm run format:check && npm run lint:a11y --workspace @ares/frontend && npm run prisma:validate && npm run prisma:generate && npm test && npm run check && npm run build",
    "format": "npm run format:root && npm run format --workspaces --if-present",
    "format:root": "prettier --write \"package.json\" \"*.md\" \"docs/**/*.md\" \"frontend/*.md\" \"frontend/e2e/*.md\" \"postman/*.md\" \"scripts/*.mjs\" \"compose*.yaml\" \".github/**/*.yml\"",
    "format:check": "npm run format:check:root && npm run format:check --workspaces --if-present",
    "format:check:root": "prettier --check \"package.json\" \"*.md\" \"docs/**/*.md\" \"frontend/*.md\" \"frontend/e2e/*.md\" \"postman/*.md\" \"scripts/*.mjs\" \"compose*.yaml\" \".github/**/*.yml\"",
    "prisma:validate": "npm run prisma:validate --workspace @ares/backend",
    "prisma:generate": "npm run prisma:generate --workspace @ares/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace @ares/backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @ares/backend --",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @ares/backend",
    "admin:bootstrap": "npm run admin:bootstrap --workspace @ares/backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "3.5.4"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "sharp@0.35.3": true,
    "sharp@0.35.5": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "argon2@0.44.0": true
  }
}
