{
  "name": "ares",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace @ares/frontend",
    "dev:backend": "npm run start:dev --workspace @ares/backend",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "quality": "npm run format:check && npm run prisma:validate && npm run prisma:generate && npm test && npm run check && npm run build",
    "format": "npm run format:root && npm run format --workspaces --if-present",
    "format:root": "prettier --write \"package.json\" \"*.md\" \".github/**/*.yml\"",
    "format:check": "npm run format:check:root && npm run format:check --workspaces --if-present",
    "format:check:root": "prettier --check \"package.json\" \"*.md\" \".github/**/*.yml\"",
    "prisma:validate": "npm run prisma:validate --workspace @ares/backend",
    "prisma:generate": "npm run prisma:generate --workspace @ares/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace @ares/backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @ares/backend --",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @ares/backend"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true
  }
}
