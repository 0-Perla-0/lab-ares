  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({key:'Accept', value:'application/json'});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const success=[200,201,204]; const negative=[400,401,403,404,409,422,429,500,503]; pm.test('status is documented',()=>pm.expect([...success,...negative]).to.include(pm.response.code));",
          "const j=(()=>{try{return pm.response.json()}catch{return null}})(); if(success.includes(pm.response.code)&&pm.response.code!==204){pm.test('success envelope',()=>pm.expect(j).to.have.property('data'));} if(negative.includes(pm.response.code)){pm.test('structured error',()=>pm.expect(j).to.be.an('object'));}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json(); pm.expect(j).to.have.property('data'); if(j.data?.challenge) pm.collectionVariables.set('mfaChallenge',j.data.challenge);"
                ]
              }
            }
          ]
        },
